"""Cross-dataset method profiles for the clean TFD-Bench setting.

The large radar chart reports the macro average across datasets. The six
smaller radar charts retain the dataset-level profiles. Every transformed
axis is bounded to [0, 1] and oriented so that larger values are better.
"""

from __future__ import annotations

import argparse
import json
import math
import sys
from collections.abc import Callable, Sequence
from pathlib import Path

import matplotlib

matplotlib.use("Agg")

import matplotlib.pyplot as plt
import numpy as np
from matplotlib.lines import Line2D

_PROJECT_ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(_PROJECT_ROOT))

from analysis.methods import (
    PLOT_METHOD_ORDER,
    PLOT_METHODS,
    display_method,
    plot_method_sort_key,
)
from analysis.visualization.io import save_figure
from analysis.visualization.style import (
    DOUBLE_COLUMN_MM,
    LEGEND_SIZE,
    LINE_WIDTH,
    SUBMISSION_DPI,
    figure_size,
    method_color,
)


DATASET_ORDER = ("seu", "wt", "pu", "xjtu", "hit", "cwru")


def _identity(value: float) -> float:
    return value


def _negative_log_likelihood_score(value: float) -> float:
    return math.exp(-max(value, 0.0))


def _complement(value: float) -> float:
    return 1.0 - value


PROFILE_METRICS: tuple[tuple[str, str, Callable[[float], float]], ...] = (
    ("test/cls/Acc", "ACC", _identity),
    ("test/cls/NLL", "NLL", _negative_log_likelihood_score),
    ("test/cls/Brier", "Brier", _complement),
    ("test/cal/ECE", "ECE", _complement),
    ("ood/AUROC", "AUROC", _identity),
    ("test/sc/AURC", "AURC", _complement),
)


def _mean_metric(metrics: dict, key: str) -> float | None:
    value = metrics.get(key)
    if value is None:
        return None
    if isinstance(value, dict):
        value = value.get("mean")
    if value is None:
        return None
    number = float(value)
    return number if np.isfinite(number) else None


def load_profile_data(
    summary: dict,
    *,
    backbone: str,
    datasets: Sequence[str],
    methods: Sequence[str] | None = None,
) -> dict[str, dict[str, np.ndarray]]:
    """Load complete clean profiles grouped by dataset and raw method name."""

    allowed_methods = set(methods) if methods else set(PLOT_METHODS)
    profiles: dict[str, dict[str, np.ndarray]] = {
        dataset: {} for dataset in datasets
    }
    for record in summary.values():
        dataset = record.get("dataset")
        method = record.get("method")
        if (
            dataset not in profiles
            or record.get("backbone") != backbone
            or record.get("config", "clean") != "clean"
            or method not in allowed_methods
        ):
            continue

        metrics = record.get("metrics", {})
        values = []
        for key, _, transform in PROFILE_METRICS:
            value = _mean_metric(metrics, key)
            if value is None:
                break
            values.append(float(np.clip(transform(value), 0.0, 1.0)))
        if len(values) == len(PROFILE_METRICS):
            profiles[dataset][method] = np.asarray(values, dtype=float)

    missing_datasets = [dataset for dataset, values in profiles.items() if not values]
    if missing_datasets:
        raise ValueError(
            "No complete clean profiles for: " + ", ".join(missing_datasets)
        )

    common_methods = set.intersection(
        *(set(profiles[dataset]) for dataset in datasets)
    )
    if not common_methods:
        raise ValueError("No method has a complete profile across all datasets.")

    return {
        dataset: {
            method: profiles[dataset][method]
            for method in sorted(common_methods, key=plot_method_sort_key)
        }
        for dataset in datasets
    }


def _angles() -> np.ndarray:
    count = len(PROFILE_METRICS)
    return np.linspace(0.0, 2.0 * np.pi, count, endpoint=False)


def _configure_radar(ax: plt.Axes, *, label_size: float) -> None:
    angles = _angles()
    ax.set_theta_offset(np.pi / 2.0)
    ax.set_theta_direction(-1)
    ax.set_xticks(angles)
    ax.set_xticklabels(
        [label for _, label, _ in PROFILE_METRICS],
        fontsize=label_size,
    )
    ax.set_ylim(0.0, 1.0)
    ax.set_yticks((0.5, 1.0))
    ax.set_yticklabels(("0.5", "1.0"), fontsize=max(label_size - 1, 5))
    ax.set_rlabel_position(22.5)
    ax.grid(True, alpha=0.35)


def _plot_profiles(
    ax: plt.Axes,
    profiles: dict[str, np.ndarray],
    *,
    linewidth: float,
    alpha: float,
) -> None:
    angles = _angles()
    closed_angles = np.concatenate((angles, angles[:1]))
    for method, values in profiles.items():
        closed_values = np.concatenate((values, values[:1]))
        ax.plot(
            closed_angles,
            closed_values,
            color=method_color(method),
            linewidth=linewidth,
            alpha=alpha,
        )


def generate_cross_dataset_profile(
    summary: dict,
    *,
    backbone: str = "resnet",
    datasets: Sequence[str] = DATASET_ORDER,
    methods: Sequence[str] | None = None,
) -> plt.Figure:
    """Create one macro profile and six dataset-level radar charts."""

    datasets = tuple(datasets)
    if len(datasets) != 6:
        raise ValueError("The cross-dataset profile requires exactly six datasets.")

    profiles = load_profile_data(
        summary,
        backbone=backbone,
        datasets=datasets,
        methods=methods,
    )
    method_names = list(next(iter(profiles.values())))
    macro_profiles = {
        method: np.mean(
            np.stack([profiles[dataset][method] for dataset in datasets]),
            axis=0,
        )
        for method in method_names
    }

    fig = plt.figure(figsize=figure_size(DOUBLE_COLUMN_MM, 100))
    grid = fig.add_gridspec(
        2,
        4,
        width_ratios=(1.65, 1.0, 1.0, 1.0),
        wspace=0.42,
        hspace=0.48,
    )

    macro_ax = fig.add_subplot(grid[:, 0], projection="polar")
    _configure_radar(macro_ax, label_size=8)
    _plot_profiles(
        macro_ax,
        macro_profiles,
        linewidth=LINE_WIDTH + 0.25,
        alpha=0.9,
    )
    macro_ax.set_title("Cross-dataset mean", pad=14)

    for index, dataset in enumerate(datasets):
        row, column = divmod(index, 3)
        ax = fig.add_subplot(grid[row, column + 1], projection="polar")
        _configure_radar(ax, label_size=6)
        _plot_profiles(
            ax,
            profiles[dataset],
            linewidth=max(LINE_WIDTH - 0.15, 0.65),
            alpha=0.78,
        )
        ax.set_title(dataset.upper(), pad=9)

    legend_handles = [
        Line2D(
            [0],
            [0],
            color=method_color(method),
            linewidth=LINE_WIDTH + 0.25,
            label=display_method(method),
        )
        for method in method_names
    ]
    fig.legend(
        handles=legend_handles,
        loc="lower center",
        bbox_to_anchor=(0.5, 0.01),
        ncol=7,
        frameon=False,
        fontsize=LEGEND_SIZE,
        handlelength=2.0,
        columnspacing=1.2,
    )
    fig.subplots_adjust(
        left=0.035,
        right=0.95,
        bottom=0.15,
        top=0.88,
    )
    return fig


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Plot macro and dataset-level clean method profiles."
    )
    parser.add_argument(
        "--summary",
        default=str(_PROJECT_ROOT / "results" / "summary.json"),
    )
    parser.add_argument("--backbone", default="resnet")
    parser.add_argument(
        "--datasets",
        nargs=6,
        default=list(DATASET_ORDER),
    )
    parser.add_argument("--methods", nargs="*")
    parser.add_argument(
        "--output",
        default=str(
            _PROJECT_ROOT
            / "results"
            / "figures"
            / "cross_dataset_profile.png"
        ),
    )
    parser.add_argument("--dpi", type=int, default=SUBMISSION_DPI)
    args = parser.parse_args()

    with Path(args.summary).open(encoding="utf-8") as stream:
        summary = json.load(stream)
    figure = generate_cross_dataset_profile(
        summary,
        backbone=args.backbone,
        datasets=args.datasets,
        methods=args.methods,
    )
    path = save_figure(figure, args.output, args.dpi)
    plt.close(figure)
    print(f"Saved: {path}")


if __name__ == "__main__":
    main()
